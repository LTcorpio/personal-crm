# ============================================================
# personal-crm（Go 后端）配置示例：复制为 .env 后按需修改
# ============================================================

# ---- 服务 ----
PORT=15197

# ---- 数据目录 ----
# 数据库目录：crm.db 与 roster.db 都放在这里（相对工作目录，可写绝对路径）
DB_DIR=./data
# 头像目录（可选）：默认跟随 DB_DIR，即 $DB_DIR/avatars
# 头像按内容哈希命名，同一张图全库只存一份；与数据库同目录便于备份服务整目录拷贝
# AVATAR_DIR=

# ---- Immich（只在「抓取 / 同步头像」时访问，日常展示读本地文件）----
# 留空时代码内置默认值 https://photo.home.lan
IMMICH_BASE_URL=https://photo.home.lan
IMMICH_API_KEY=
